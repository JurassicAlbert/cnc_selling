# Copy to `.env` and adjust. `.env` is gitignored and never leaves your machine.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Start it with:  docker compose up -d db
# Port 5433, not 5432: a native Postgres install already listens on 5432 on
# the dev machine this was set up on.
DATABASE_URL="postgresql://cnc:cnc_dev_password@127.0.0.1:5433/cnc_selling?schema=public"

# Integration tests run against a separate database so a truncating test can
# never wipe your development data. Created by docker/postgres-init.
TEST_DATABASE_URL="postgresql://cnc:cnc_dev_password@127.0.0.1:5433/cnc_selling_test?schema=public"

# Hosted alternative, if you ever stop running Docker locally: a Neon branch
# works unchanged — replace DATABASE_URL with the connection string Neon gives
# you and keep `?sslmode=require`. Nothing in the schema is Docker-specific.
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/cnc_selling?sslmode=require"

# ---------------------------------------------------------------------------
# Seed data
# ---------------------------------------------------------------------------
# The email that becomes the first ADMIN when `npm run db:seed` runs. There
# is no other path to that role (docs/ARCHITECTURE.md §16.3) — deliberately
# not hardcoded into prisma/seed.ts, since that file is committed to a public
# repo and a personal email doesn't belong in source.
SEED_ADMIN_EMAIL="you@example.com"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used to resolve absolute canonical/Open Graph URLs (src/app/layout.tsx).
# Falls back to http://localhost:3000 in dev if unset — only needs setting
# once a real domain exists.
# NEXT_PUBLIC_SITE_URL="https://example.pl"

# ---------------------------------------------------------------------------
# Sessions (P5)
# ---------------------------------------------------------------------------
# HMAC key for the signed guest-cart session cookie (docs/ARCHITECTURE.md
# §15.1 — "a signed guest session cookie", and the Configuration.sessionToken
# schema comment: "Signed cookie value, never derived from the request
# body"). Any long random string; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every open guest cart — fine in dev, worth
# planning around before a real launch. Not shared with Better Auth's own
# secret below — different mechanism, different blast radius.
SESSION_SECRET="dev-only-change-me"

# ---------------------------------------------------------------------------
# Accounts (P6)
# ---------------------------------------------------------------------------
# Better Auth's signing secret (session tokens, OTP hashing). Generate with
# the same command as SESSION_SECRET above. Rotating this invalidates every
# open login session.
BETTER_AUTH_SECRET="dev-only-change-me"

# ---------------------------------------------------------------------------
# Mail (P6)
# ---------------------------------------------------------------------------
# Optional. Unset in dev: the mailer logs instead of sending (src/server/mail
# /mailer.ts's UnconfiguredMailer). Set both to send real email via Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="CNC Selling <no-reply@example.pl>"
