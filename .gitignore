node_modules/
.next/
out/
build/
dist/
coverage/

# Auto-generated by Next.js on every dev/build run. Never edited, never
# committed — it can also rewrite tsconfig.json's compilerOptions in place
# (jsx, allowJs, include) the same way; that's expected, not a regression.
next-env.d.ts

# Claude Code session-local state (this machine, this run) — not project
# content. .claude/launch.json (the dev-server preview config) IS committed.
.claude/scheduled_tasks.lock

.env
.env.local
.env.*.local

*.log
npm-debug.log*
.DS_Store
Thumbs.db

/uploads-dev/
/playwright-report/
/test-results/
.vitest/
*.tsbuildinfo

# Prisma client is generated from prisma/schema.prisma by `npm run prisma:generate`
# (also run automatically on `npm install`). Never edited, never committed.
/src/generated/
