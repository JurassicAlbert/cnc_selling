// CNC Selling - data model.
//
// Design notes that govern this whole file (docs/ARCHITECTURE.md §6.1,
// docs/HANDOVER.md §4). Breaking one of these is a bug, not a style choice:
//
//   * Money is INTEGER GROSZE. Field names end in `Grosze`. No Float, no
//     Decimal, no złoty outside the display layer.
//   * Multipliers are BASIS POINTS. `priceFactorBp = 11500` means x1.15.
//     10000 leaves the amount unchanged.
//   * Lengths are INTEGER MILLIMETRES. Field names end in `Mm`.
//   * Sub-millimetre production tolerances are INTEGER MICROMETRES, suffix
//     `Um`: 1200 um = 1.2 mm. See the note above `Material` for why these are
//     not Float, which is what ARCHITECTURE.md §6.3 originally proposed.
//   * Machining time is INTEGER THOUSANDTHS OF A MINUTE per m²
//     (`machiningMilliMinutesPerM2`): 2500 = 2.5 min/m².
//   * `…Pl` marks a column holding customer-visible Polish copy. Everything
//     else - identifiers, enums, comments - is English.
//
// The domain layer in `src/domain` owns the rules; this file owns storage.
// `src/server/mapping` is the only place allowed to convert between them, and
// it is unit-tested precisely because that seam is where a schema change would
// silently break pricing.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection string lives in prisma.config.ts (Prisma 7 no longer reads
  // `url` from the schema).
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// LOFT_FURNITURE and JEWELRY added 2026-08-23 once the owner's real catalogue
/// diverged from the original brief's five assumed types. Neither needed a
/// structural rework: LOFT_FURNITURE reuses TABLE_TOP's exact step list (the
/// steel base is a bought-in accessory, described in copy for now rather than
/// a modelled component - see docs/HANDOVER.md for why), and JEWELRY drops
/// THICKNESS/FINISH since a small engraved blank has neither. See §5's
/// updated step table in docs/ARCHITECTURE.md.
enum ProductTypeCode {
  WALL_ART
  TABLE_TOP
  KITCHEN_TILE
  FLOOR_ELEMENT
  CUSTOM
  LOFT_FURNITURE
  JEWELRY
}

/// Real joinery techniques for the "joined panel" large-format tier
/// (`Product.supportsPanelJoinery`) - see that field's comment. Only one
/// member today: Yato-yane (a grooved-edge spline/loose-tongue joint), the
/// one of the owner's three candidate techniques that actually joins two
/// separate flat panels edge-to-edge into one larger surface and is
/// CNC-millable, unlike the other two (Suri-tsugi is a hand-planed glue-fit
/// technique; Hashibami stabilizes one existing panel rather than joining
/// two).
enum JoineryTechniqueCode {
  YATO_YANE_SPLINE
}

model Category {
  id         String    @id @default(cuid())
  slug       String    @unique // "obrazy-drewniane" - transliterated, never percent-encoded
  namePl     String
  descPl     String    @db.Text
  seoTitlePl String
  seoDescPl  String
  imageUrl   String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@index([isActive, sortOrder])
}

/// Scaffold only, added 2026-08-25 at the owner's request - real
/// infrastructure, zero seeded rows. No admin panel exists yet (P7), so a
/// real post today means a manual DB insert until one does; the same
/// honest limitation as every other "prepared, not yet wired to an
/// editor" piece in this project. `publishedAt` doubles as a draft flag:
/// null means not yet published, so a row can exist without going live.
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titlePl     String
  shortDescPl String
  bodyPl      String    @db.Text
  seoTitlePl  String
  seoDescPl   String
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, publishedAt])
}

model Product {
  id                 String          @id @default(cuid())
  slug               String          @unique
  typeCode           ProductTypeCode
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id])
  namePl             String
  shortDescPl        String
  longDescPl         String          @db.Text
  careInstructionsPl String          @db.Text
  installationInfoPl String?         @db.Text
  /// "Blat. Nogi nie są w zestawie." - rendered on the product page, in the
  /// configurator summary AND in the order confirmation (§12).
  materialNotesPl    String?         @db.Text
  seoTitlePl         String
  seoDescPl          String

  /// Floor price before any component is added.
  basePriceGrosze   Int
  /// The clamp: never sold below this, whatever the components add up to.
  /// **NET, and an internal figure** - never show it to a customer. It was
  /// being rendered as the catalogue's "od X zł" until 2026-08-31, which
  /// understated every price by the VAT rate and, for several products, was
  /// below anything that could actually be built. Use
  /// `startingPriceGrossGrosze` for anything customer-facing.
  minPriceGrosze    Int
  /// The advertised "od X zł" - the GROSS price of the cheapest
  /// configuration a customer could actually buy, computed by
  /// `server/pricing/starting-price.ts` and refreshed whenever anything
  /// that can move a price changes.
  ///
  /// Stored rather than computed per request because a category page
  /// renders many products and each computation needs that product's whole
  /// option graph. `null` means "genuinely not knowable yet" - a `CUSTOM`
  /// product cannot be priced before the customer's own artwork exists -
  /// and every caller must then render no price at all, never zero.
  startingPriceGrossGrosze Int?
  productionDaysMin Int
  productionDaysMax Int

  // Dimension envelope - feeds domain/dimensions DimensionEnvelope.
  minWidthMm        Int
  maxWidthMm        Int
  minHeightMm       Int
  maxHeightMm       Int
  /// width/height, in basis points: 2000 = 0.2, forbidding a 20x100 cm sliver.
  /// Basis points rather than Float so the "exactly at the bound" test case
  /// compares two integers.
  minAspectRatioBp  Int?
  maxAspectRatioBp  Int?
  allowsCustomSize  Boolean @default(true)
  /// Floor elements: the customer must state final dimensions (§11).
  requiresExactSize Boolean @default(false)

  /// Large-format tier: whether two-or-more of this product's normal-size
  /// panels can be joined into one larger piece. Real but inert today - no
  /// server action, resolver, or UI reads this field yet (see
  /// `src/domain/joinery`). Default false on every product, same
  /// "modelled, not yet enforced" precedent as
  /// MachineSettings.jointAllowanceMm and THICKNESS_EXCEEDS_MACHINE.
  supportsPanelJoinery Boolean               @default(false)
  joineryTechniqueCode JoineryTechniqueCode?
  /// The larger envelope that applies once panels are joined - distinct
  /// from maxWidthMm/maxHeightMm above, which stay the single-panel limit.
  joinedMaxWidthMm     Int?
  joinedMaxHeightMm    Int?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presetSizes      ProductPresetSize[]
  materials        ProductMaterial[]
  designs          ProductDesign[]
  thicknesses      ProductThickness[]
  images           ProductImage[]
  personalization  PersonalizationSpec?
  installVariants  InstallationVariant[]
  configurations   Configuration[]
  finishExclusions ProductFinishExclusion[]
  /// P9 phase 4: membership in a `ProductCollection` ("ready-made" curated
  /// grouping) - unrelated to `DesignCollection`, which groups *patterns*.
  collectionItems  ProductCollectionItem[]

  @@index([categoryId, isActive])
  @@index([typeCode, isActive])
}

model ProductPresetSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  widthMm   Int
  heightMm  Int
  labelPl   String // "30 × 40 cm"
  sortOrder Int     @default(0)

  @@unique([productId, widthMm, heightMm])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// Required: an image with no alt text fails both accessibility and SEO.
  altPl     String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

// ---------------------------------------------------------------------------
// Materials, thickness, finishes
// ---------------------------------------------------------------------------

enum MaterialFamily {
  SOLID_WOOD
  PLYWOOD
  MDF
  CERAMIC
  LEATHER
  OTHER
}

/// Solid wood with directional grain cannot have its module grid freely
/// rotated (§9). NONE means rotation is allowed.
enum GrainDirection {
  NONE
  LENGTHWISE
}

/// Production tolerances (`minLineWidthUm`, `minDetailSpacingUm`,
/// `minTextHeightUm`) are integer micrometres, not Float millimetres.
///
/// The domain compares a scaled design feature against the material minimum
/// and the boundary case ("exactly 1.2 mm on a material whose minimum is
/// 1.2 mm") is a real test in tests/unit/feasibility.test.ts. Stored as
/// double precision, 1.2 is not exactly 1.2 and that comparison can flip.
/// Integer micrometres make it exact, and follow the same convention already
/// used for `machiningMilliMinutesPerM2`.
model Material {
  id                String         @id @default(cuid())
  slug              String         @unique // "dab"
  namePl            String // "Dąb"
  family            MaterialFamily
  shortDescPl       String
  characteristicsPl String         @db.Text
  imageUrl          String
  pricePerM2Grosze  Int
  /// 2026-08-29, owner request: real shipping weight, computed instead of
  /// guessed, needs a real material density. Sourced from standard,
  /// published wood-density reference values (seasoned/kiln-dried, ~12%
  /// moisture) and porcelain-stoneware (gres) reference density - see
  /// `prisma/seed.ts`'s `MATERIAL_SEEDS` for the actual figures used and
  /// their sourcing note. Never a business-specific fabricated number.
  densityKgPerM3    Int
  isAvailable       Boolean        @default(true)
  sortOrder         Int            @default(0)

  // Production envelope - limits module size independently of the machine.
  maxSheetWidthMm    Int
  maxSheetHeightMm   Int
  minLineWidthUm     Int
  minDetailSpacingUm Int
  minTextHeightUm    Int
  grainDirection     GrainDirection @default(NONE)
  supportsCnc        Boolean        @default(true)
  supportsLaser      Boolean        @default(true)
  /// Triggers the grain/knot/colour disclaimer (NATURAL_VARIATION notice).
  isNaturalVariable  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       ProductMaterial[]
  finishes       MaterialFinish[]
  designs        DesignMaterial[]
  configurations Configuration[]

  stock MaterialStock[]

  @@index([isAvailable, sortOrder])
}

/// A batch of physical boards actually held in the workshop - the owner's
/// 2026-09-04 request to "save materials what we have on magazine".
///
/// This is the first place the shop records what it PAID, as opposed to what
/// it charges (`Material.pricePerM2Grosze`, which drives `domain/pricing`).
/// The two together are what make a minimum viable price computable at all;
/// see `src/domain/stock/board.ts`.
///
/// One row is one batch of identically sized boards, not one board, because
/// that is how they are bought and how a delivery note reads. `quantity` is
/// the count still on the shelf.
model MaterialStock {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  /// The board as delivered. Integer millimetres, like every other dimension
  /// in this schema.
  widthMm     Int
  heightMm    Int
  thicknessMm Int

  /// How many boards of this exact size are still held.
  quantity Int @default(0)

  /// Net price for ONE board of these dimensions, in grosze. Per board rather
  /// than per batch so the figure survives partial use: consuming three of
  /// five boards must not change what each one cost.
  purchasePriceGrosze Int

  /// Where it came from, so a restock does not start with a search. Free text
  /// rather than a Supplier table: there is no second use for a supplier
  /// record yet, and inventing one now would be a model without a caller.
  supplierNamePl String?
  supplierUrl    String?

  /// Delivery note number, shelf, batch quirks. Staff-facing only.
  notePl String? @db.Text

  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([materialId])
  @@index([purchasedAt])
}

/// Compatibility: which materials are offered for which product, and the
/// per-product premium for that material.
model ProductMaterial {
  productId     String
  materialId    String
  priceFactorBp Int      @default(10000)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([productId, materialId])
  @@index([materialId])
}

model ProductThickness {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  thicknessMm   Int
  priceFactorBp Int     @default(10000)
  labelPl       String // "27 mm"
  sortOrder     Int     @default(0)

  @@unique([productId, thicknessMm])
}

enum FinishKind {
  NATURAL
  OIL
  HARDWAX_OIL
  STAIN
  VARNISH
}

model Finish {
  id               String     @id @default(cuid())
  slug             String     @unique
  namePl           String // "Olejowanie"
  kind             FinishKind
  descPl           String
  imageUrl         String
  pricePerM2Grosze Int
  setupFeeGrosze   Int        @default(0)
  extraDaysMin     Int        @default(0)
  extraDaysMax     Int        @default(0)
  isAvailable      Boolean    @default(true)
  sortOrder        Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials         MaterialFinish[]
  configurations    Configuration[]
  productExclusions ProductFinishExclusion[]

  @@index([isAvailable, sortOrder])
}

/// Compatibility: which finish may be applied to which material.
model MaterialFinish {
  materialId String
  finishId   String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  finish     Finish   @relation(fields: [finishId], references: [id], onDelete: Cascade)

  @@id([materialId, finishId])
  @@index([finishId])
}

/// 2026-08-29: `MaterialFinish` is a per-material rule ("oak may be
/// oiled/stained/varnished") - real, but not enough on its own once two
/// products share a material yet should offer different finishes (owner
/// request: bejcowanie/lakierowanie stay off by default for the "Obrazy"
/// wall-art product even though dąb itself supports them elsewhere). A row
/// here means "this finish is excluded for this product" even when the
/// material otherwise allows it - resolved as an extra filter on top of
/// `MaterialFinish`, never instead of it. No admin UI yet (seeded directly);
/// a real gap, same "establishes the pattern, not a full sweep" scoping
/// this session's admin-polish passes already used elsewhere.
model ProductFinishExclusion {
  productId String
  finishId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  finish    Finish  @relation(fields: [finishId], references: [id], onDelete: Cascade)

  @@id([productId, finishId])
  @@index([finishId])
}

// ---------------------------------------------------------------------------
// Designs, production metadata, rights
// ---------------------------------------------------------------------------

enum DesignRightsStatus {
  APPROVED_COMMERCIAL // ours, or licensed for sale
  REQUIRES_PERMISSION
  PUBLIC_DOMAIN
  CUSTOMER_SUPPLIED
  RESTRICTED // catalogued, never offered
}

enum ProductionMethod {
  CNC_CARVE
  CNC_ENGRAVE
  LASER_ENGRAVE
  MIXED
  MANUAL_PREP
}

model DesignCollection {
  id        String   @id @default(cuid())
  slug      String   @unique
  namePl    String
  descPl    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  designs   Design[]
}

model Design {
  id           String            @id @default(cuid())
  slug         String            @unique // "linoryt-01"
  code         String            @unique // stable human ID used on the shop floor
  namePl       String
  descPl       String?           @db.Text
  collectionId String?
  collection   DesignCollection? @relation(fields: [collectionId], references: [id])
  tags         String[]
  thumbnailUrl String
  previewUrl   String
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  /// P9 phase 2: admin-curated highlight, shown first/prominently on the real pattern-browsing page. Purely presentational - no pricing or availability meaning.
  featured     Boolean           @default(false)

  // Production metadata.
  /// The width at which the minimums below are declared. Producing the design
  /// at another width scales every feature by widthMm / referenceWidthMm (§8).
  referenceWidthMm           Int
  minLineWidthUm             Int
  minDetailSpacingUm         Int
  minEngraveDepthUm          Int?
  recommendedMethod          ProductionMethod
  /// Below this width the design loses its character.
  minRecommendedWidthMm      Int
  maxRecommendedWidthMm      Int?
  /// 1..5. 4 and above is "very detailed" and drives DESIGN_TOO_DETAILED.
  detailLevel                Int
  /// Thousandths of a minute per m². 2500 = 2.5 min/m². Integer on purpose:
  /// a Float here would put floating point back into the price chain.
  machiningMilliMinutesPerM2 Int

  // Rights (brief §12). Only APPROVED_COMMERCIAL and PUBLIC_DOMAIN are ever
  // selectable in the configurator - enforced by a query filter, not by
  // discipline. A new design deliberately defaults to non-sellable.
  rightsStatus    DesignRightsStatus @default(REQUIRES_PERMISSION)
  sourceArtist    String?
  sourceTitle     String?
  sourceYear      Int?
  artistDeathYear Int?
  sourceRef       String?
  rightsNotes     String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       ProductDesign[]
  /// Optional narrowing. No rows means "every material the product allows".
  materials      DesignMaterial[]
  configurations Configuration[]
  favoritedBy    DesignFavorite[]

  @@index([isActive, rightsStatus])
  @@index([collectionId])
}

model ProductDesign {
  productId       String
  designId        String
  surchargeGrosze Int     @default(0)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  design          Design  @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@id([productId, designId])
  @@index([designId])
}

/// P9 phase 4: curated "ready-made" groupings of independently-created
/// products - deliberately a NEW, separate model from `DesignCollection`
/// above, which groups *patterns* (e.g. "linoryt series"), not sellable
/// products. A product can belong to more than one collection, or none.
model ProductCollection {
  id        String                  @id @default(cuid())
  slug      String                  @unique
  namePl    String
  descPl    String                  @db.Text
  imageUrl  String?
  sortOrder Int                     @default(0)
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  items     ProductCollectionItem[]

  @@index([isActive, sortOrder])
}

model ProductCollectionItem {
  collectionId String
  productId    String
  sortOrder    Int               @default(0)
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model DesignMaterial {
  designId   String
  materialId String
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([designId, materialId])
  @@index([materialId])
}

/// P9 phase 3: links to free/external pattern sources (e.g. 3axis.co) shown
/// on the customer-facing pattern-browsing page. Never our own content - the
/// frontend must always label these as external, `target="_blank"`. Admin
/// CRUD only, no delete (isActive toggle, same as every other catalogue
/// entity) - see `Faq` for the identical shape/precedent.
model ExternalPatternResource {
  id          String   @id @default(cuid())
  namePl      String
  url         String
  descPl      String?  @db.Text
  /// Short label naming the source site, shown as a badge next to the link (e.g. "3axis.co").
  sourceLabel String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Kitchen installation variants
// ---------------------------------------------------------------------------

enum InstallationVariantCode {
  ON_TOP // mounted on/over an existing tile
  OVERLAY // thin overlay glued to an existing tile
  REPLACEMENT // replaces one existing backsplash tile
}

/// First-class rows because brief §4 warns that customers must never be
/// confused about WHAT THEY ARE BUYING. The variant is the first configurator
/// step for kitchen tiles, carries a diagram, and its "Co otrzymujesz" line
/// goes into the summary and the order snapshot.
model InstallationVariant {
  id             String                  @id @default(cuid())
  productId      String
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  code           InstallationVariantCode
  namePl         String // "Nakładka na istniejący kafelek"
  descPl         String                  @db.Text
  /// What the customer physically receives. Shown in the summary verbatim.
  receivesPl     String                  @db.Text
  diagramUrl     String
  /// OVERLAY is thickness-constrained by definition.
  maxThicknessMm Int?
  priceFactorBp  Int                     @default(10000)
  sortOrder      Int                     @default(0)

  @@unique([productId, code])
}

// ---------------------------------------------------------------------------
// Personalization
// ---------------------------------------------------------------------------

model PersonalizationSpec {
  id                 String   @id @default(cuid())
  productId          String   @unique
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  isEnabled          Boolean  @default(true)
  maxCharacters      Int      @default(40)
  maxLines           Int      @default(2)
  /// Product-level floor. The effective minimum is the STRICTER of this and
  /// the chosen material's `minTextHeightUm` - resolved in the mapper.
  minTextHeightUm    Int      @default(6000)
  pricePerCharGrosze Int      @default(0)
  flatFeeGrosze      Int      @default(0)
  allowedFontIds     String[]
}

/// A font used for ENGRAVED text, not for the website's typeface.
///
/// Decorative faces frequently ship Basic Latin only. A customer types
/// „Michał", the preview silently substitutes a fallback glyph, and the
/// mistake becomes permanent on a finished oak tabletop that cannot be re-run.
/// So coverage is parsed from the font's cmap table at seed time and stored -
/// never assumed from the font's name or its declared language support.
model Font {
  id                       String  @id @default(cuid())
  slug                     String  @unique
  namePl                   String
  /// Storage key for the actual font file. The preview MUST render with this
  /// same file, or the preview is a lie.
  fileUrl                  String
  /// Below this cap height this particular face stops being legible.
  minHeightUm              Int
  /// Covered code points as inclusive ranges: [[32,126],[260,263], ...].
  /// Ranges rather than a flat array because a full face covers thousands of
  /// code points. The mapper expands them into the Set the domain expects.
  coveredCodePointRanges   Json
  /// Denormalised convenience flag for admin listing ("does this face have
  /// ą ć ę ł ń ó ś ź ż at all?"). NEVER used for validation - the ranges are.
  supportsPolishDiacritics Boolean @default(false)
  isActive                 Boolean @default(true)
  sortOrder                Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configurations Configuration[]
}

// ---------------------------------------------------------------------------
// Pricing and machine settings
// ---------------------------------------------------------------------------

/// Rate set. NEVER edited in place: every save writes a new row with the next
/// `version`, so an order pinned to version 3 reprices to exactly what was
/// charged (§10.2, §16A.1 module 7).
///
/// The active set is the highest `version` with `publishedAt` set. A partial
/// unique index enforcing "at most one active" is added in the migration SQL,
/// because Prisma cannot express `WHERE is_active` on an index.
model PricingSettings {
  version                Int       @id
  machineRateCncGrosze   Int
  machineRateLaserGrosze Int
  moduleSurchargeGrosze  Int
  /// Packaging tiers as [{ maxAreaM2, maxModules, priceGrosze }, ...],
  /// evaluated in order. JSON because the tier COUNT changes with the
  /// courier, and a table of three rows read on every price call is not worth
  /// the join.
  packagingTiers         Json
  vatRateBp              Int       @default(2300)
  isActive               Boolean   @default(false)
  publishedAt            DateTime?
  /// Who published it and why - this table changes every price on the site.
  publishedByEmail       String?
  notePl                 String?   @db.Text
  createdAt              DateTime  @default(now())

  configurations Configuration[]

  @@index([isActive])
}

/// True singleton: one row, id = 1. The real machine's usable area after
/// clamping and tool clearance, plus the smallest module we will produce.
/// These are DB values and not constants because they must be correctable
/// without a deploy.
///
/// D7 resolved 2026-08-23 with the owner: usableWidthMm 600, usableHeightMm
/// 500 (the machine can feed material either way, so which axis is which
/// does not matter), minModuleMm kept at the original 150 assumption, and
/// maxWorkpieceThicknessMm 100 - the machine's Z-axis limit, a hardware
/// capability distinct from `ProductThickness` or any material's own sheet
/// limits. Recorded here for the seed script (P2); not yet enforced by any
/// domain rule - `domain/feasibility` has no THICKNESS_EXCEEDS_MACHINE check
/// yet, so a product configured thicker than this is not currently rejected.
model MachineSettings {
  id                      Int      @id @default(1)
  usableWidthMm           Int
  usableHeightMm          Int
  minModuleMm             Int
  /// The machine's Z-axis limit. Distinct from a material's own sheet or
  /// thickness limits - this one is a hardware ceiling that applies no
  /// matter what is being cut.
  maxWorkpieceThicknessMm Int
  /// Allowance per joint, reserved for the future production pipeline.
  jointAllowanceMm        Int      @default(0)
  /// Weekly capacity for the admin production load view (§16A.1 module 10).
  weeklyCapacityMinutes   Int      @default(0)
  updatedAt               DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Configuration, cart
// ---------------------------------------------------------------------------

model Configuration {
  id           String  @id @default(cuid())
  userId       String?
  user         User?   @relation(fields: [userId], references: [id])
  /// Guest ownership. Signed cookie value, never derived from the request body.
  sessionToken String?
  productId    String
  product      Product @relation(fields: [productId], references: [id])

  designId       String?
  design         Design?                  @relation(fields: [designId], references: [id])
  customDesignId String?
  customDesign   CustomerDesign?          @relation(fields: [customDesignId], references: [id])
  materialId     String?
  material       Material?                @relation(fields: [materialId], references: [id])
  finishId       String?
  finish         Finish?                  @relation(fields: [finishId], references: [id])
  thicknessMm    Int?
  widthMm        Int?
  heightMm       Int?
  installVariant InstallationVariantCode?

  personalizationText String?
  fontId              String?
  font                Font?   @relation(fields: [fontId], references: [id])

  // Server-computed, cached for display. The client never derives these.
  moduleCount          Int?
  /// ModuleLayout from domain/modules: { cols, rows, modules: [...] }.
  moduleLayout         Json?
  /// PriceBreakdown from domain/pricing. Every component named, in grosze.
  priceBreakdown       Json?
  priceGrossGrosze     Int?
  /// FeasibilityFinding[] from domain/feasibility.
  warnings             Json?
  /// Which acknowledgeable warnings the customer explicitly accepted.
  acknowledgedWarnings String[]
  pricingVersion       Int?
  pricingSettings      PricingSettings? @relation(fields: [pricingVersion], references: [version])

  isComplete Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartItems CartItem[]

  @@index([userId])
  @@index([sessionToken])
  @@index([productId])
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id])
  sessionToken String?    @unique
  items        CartItem[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Two different configurations of the same product are two CartItem rows
/// pointing at two Configuration rows - the brief's edge case is satisfied
/// structurally.
///
/// Two IDENTICAL configurations are never two rows. Enforced by
/// `@@unique([cartId, configurationSignature])` below and by every write
/// path in `server/operations/cart.ts` (add, duplicate, edit) merging into
/// the existing line instead of creating a twin.
///
/// This comment used to say the opposite of that last part - "Duplicate
/// deep-copies the Configuration; it does not increment quantity" - which
/// was a deliberate decision the owner reversed on 2026-08-30: "duplicate
/// the same product in basket like separate product since its the same only
/// the quantity should change." Left recorded rather than quietly swapped.
model CartItem {
  id              String        @id @default(cuid())
  cartId          String
  cart            Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  configurationId String
  configuration   Configuration @relation(fields: [configurationId], references: [id])
  quantity        Int           @default(1)
  addedAt         DateTime      @default(now())
  /// 2026-08-30 (`docs/AUDIT-2026-08-30.md` P1-4): the line's own identity
  /// - `domain/cart/signature.ts` builds it from exactly the selections a
  /// customer makes, and that file's header explains which and why. The
  /// unique index below is what makes "adding the identical thing twice
  /// bumps the quantity" true even for two genuinely concurrent requests;
  /// a read-then-create check alone would race, which is how the
  /// double-click duplicate got in. Rows created before this column exists
  /// carry a `legacy:` value derived from their own configuration id -
  /// unique by construction, and honestly not a real signature, so they
  /// simply never merge with anything.
  configurationSignature String
  @@unique([cartId, configurationSignature])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  DESIGN_REVIEW
  CONFIRMED
  IN_PRODUCTION
  FINISHING
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CONTACT_ARRANGED
  /// P9 phase 6: real DB row exists (`PaymentMethodConfig`), `isConnected: false`
  /// - visible to admins, never selectable at checkout. See that model's comment.
  PRZELEWY24
  CARD
  PAYPAL
}

enum PaymentStatus {
  AWAITING
  UNDERPAID
  PAID
  REFUNDED
  /// P9 phase 6 additions - additive only, no existing value removed or
  /// repurposed. None of the two real payment methods' own tested logic
  /// (`applyMarkOrderPaid` etc.) currently produces these; they exist for
  /// a real future provider integration's honest lifecycle, not simulated.
  PENDING
  FAILED
  CANCELLED
}

/// P9 phase 6: real, admin-managed payment method configuration -
/// `isConnected: false` means "a real row, visible to staff, but never
/// selectable at checkout" - the honest "not yet integrated" state
/// (docs/ARCHITECTURE.md §14's `PaymentProvider` interface has no
/// implementation yet for anything beyond bank transfer / contact-
/// arranged). Deliberately NOT admin-editable via the form - flipping it
/// to `true` would let an admin silently "enable" a payment method with no
/// real integration behind it, exactly what §15's "no fake payment" rule
/// forbids. Only ever set `true` by real code once a real provider exists.
model PaymentMethodConfig {
  id          String        @id @default(cuid())
  namePl      String
  descPl      String        @db.Text
  provider    PaymentMethod
  isConnected Boolean       @default(false)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orders      Order[]

  @@index([isActive, isConnected, sortOrder])
}

/// P9 phase 5: real, admin-managed delivery/shipping methods - replaces the
/// single hardcoded `StoreSettings.shippingFlatRateGrosze` at checkout.
/// That field stays as-is for now (still used as the fallback when no
/// method row exists yet, e.g. right after this migration on a fresh DB)
/// but a real checkout always prefers a real `DeliveryMethod` row.
model DeliveryMethod {
  id                          String   @id @default(cuid())
  namePl                      String
  descPl                      String   @db.Text
  priceGrosze                 Int
  /// Order subtotal (net) at or above which this method becomes free. `null` = never free.
  freeShippingThresholdGrosze Int?
  estimatedDaysMin            Int
  estimatedDaysMax            Int
  carrier                     String?
  trackingAvailable           Boolean  @default(false)
  /// 2026-08-29: does this method need a real pickup point picked at
  /// checkout (a parcel locker, a courier's own pickup point) rather than
  /// just a home address? `server/delivery/pickup-points.ts` is the
  /// (honestly static, non-live) dataset the checkout picker searches -
  /// see that file's own header comment.
  requiresPickupPoint         Boolean  @default(false)
  isActive                    Boolean  @default(true)
  sortOrder                   Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  orders                      Order[]
  /// 2026-08-29, owner request: "cena powinna być przeliczana na podstawie
  /// wielkości i wagi produktu zgodnie z danymi cenowymi wybranego kuriera"
  /// - real weight-tier pricing, sourced from each carrier's own real,
  /// published price list (see `prisma/seed.ts`'s `DELIVERY_WEIGHT_TIER_SEEDS`
  /// for the exact source URL cited per method). Empty for a method with no
  /// real published tiers yet (e.g. `Odbiór osobisty`, or a carrier row
  /// prepared but not yet priced) - `priceGrosze`/`freeShippingThresholdGrosze`
  /// above stay the fallback flat rate for exactly that case.
  weightTiers                  DeliveryWeightTier[]

  @@index([isActive, sortOrder])
}

/// One weight bracket of one real carrier's own published price list -
/// `computeShippingGrosze` (`domain/checkout/delivery.ts`) picks the
/// cheapest tier whose `maxWeightGrams` is at or above the cart's real
/// total weight (`domain/shipping/weight.ts`, computed from each item's
/// real dimensions × its material's real density - never a guessed
/// per-product number). `maxWidthMm`/`maxHeightMm`/`maxDepthMm` are only
/// set for a genuine physical-locker constraint (InPost Paczkomat's real
/// door/compartment dimensions) - `null` for a courier with no such limit
/// in its own published data.
model DeliveryWeightTier {
  id               String         @id @default(cuid())
  deliveryMethodId String
  deliveryMethod   DeliveryMethod @relation(fields: [deliveryMethodId], references: [id], onDelete: Cascade)
  labelPl          String
  maxWeightGrams   Int
  priceGrosze      Int
  maxWidthMm       Int?
  maxHeightMm      Int?
  maxDepthMm       Int?
  sortOrder        Int            @default(0)

  @@index([deliveryMethodId, sortOrder])
}

model Order {
  id                    String               @id @default(cuid())
  orderNumber           String               @unique // "2026/08/0042" - from a sequence, never count()+1
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id])
  /// Guest order lookup. 32 random bytes, compared in constant time.
  accessToken           String               @unique
  /// 2026-08-30 (`docs/AUDIT-2026-08-30.md` P0-2): one checkout render's
  /// own submission id. Minted server-side per render of
  /// `/koszyk/zamowienie` and carried in a hidden field, so a double click,
  /// a retried request after a dropped connection, or a back-and-resubmit
  /// all arrive carrying the SAME value - the `@unique` here is what makes
  /// the second one return the first one's order instead of creating a
  /// second real order for one purchase. Nullable only for rows written
  /// before this column existed; every new order sets it.
  idempotencyKey        String?              @unique
  status                OrderStatus          @default(NEW)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus        @default(AWAITING)
  /// P9 phase 6: which real `PaymentMethodConfig` row was actually shown/
  /// chosen - traceability only. `paymentMethod` above stays the field the
  /// two real methods' own tested logic (`applyMarkOrderPaid` etc.) reads;
  /// this is additive, never a replacement.
  paymentMethodConfigId String?
  paymentMethodConfig   PaymentMethodConfig? @relation(fields: [paymentMethodConfigId], references: [id])

  // Buyer data is CAPTURED, never re-read from the user profile: a customer
  // who moves house must not retroactively change where an old order went.
  email       String
  /// 2026-08-29, owner request: required, not optional - a status/shipment
  /// update needs a real contact channel beyond email. Historical rows from
  /// before this requirement backfill to `''` (migration), distinguishable
  /// from a real number, never `null`.
  phone       String
  firstName   String
  lastName    String
  companyName String?
  nip         String? // validated by weighted checksum, not by length
  street      String
  postalCode  String // NN-NNN
  city        String
  countryCode String  @default("PL")

  subtotalNetGrosze Int
  vatGrosze         Int
  shippingGrosze    Int
  totalGrossGrosze  Int
  currency          String @default("PLN")

  /// P9 phase 5: which real `DeliveryMethod` row was chosen, nullable
  /// because the row can be deactivated later - the name/price actually
  /// charged are snapshotted below (`deliveryMethodNamePl`,
  /// `shippingGrosze` above), never re-read live, same discipline as
  /// `OrderItem.snapshot`.
  deliveryMethodId     String?
  deliveryMethod       DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id])
  deliveryMethodNamePl String
  /// 2026-08-29: set only when `deliveryMethod.requiresPickupPoint` was
  /// true at checkout - the id/label of the point chosen from the static
  /// dataset in `server/delivery/pickup-points.ts`, snapshotted the same
  /// way `deliveryMethodNamePl` is (that dataset could change shape later;
  /// what a customer actually picked must never move under them).
  pickupPointId        String?
  pickupPointLabel     String?
  /// 2026-08-29, owner request: the "shipping form" is really two different
  /// audiences - instructions FOR the courier (gate code, "leave with
  /// neighbour", floor number) vs a note FOR US about the shipment (nothing
  /// to do with production). Both customer-submitted at checkout, both
  /// optional, kept as two separate columns rather than one so staff and a
  /// courier label print never accidentally show the other's note.
  courierNotePl           String? @db.Text
  internalShipmentNotePl  String? @db.Text

  // Acknowledgements, stored verbatim: a consent record is only evidence if
  // it captures WHAT was agreed to. Custom-made goods are exempt from the
  // 14-day withdrawal right (art. 38 pkt 3) and that must be acknowledged.
  termsVersion              String
  termsAcceptedAt           DateTime
  withdrawalExemptionTextPl String   @db.Text
  withdrawalAcknowledgedAt  DateTime

  productionNotes String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  events          OrderEvent[]
  /// At most one - `Review.orderId` is `@unique`. A real customer testimonial
  /// requires a genuine `COMPLETED` order behind it (§16A.1 module 9: "no
  /// facility to author a testimonial in a customer's name").
  reviews         Review[]
  /// P9 phase 7: one order → one package (real reality here, not a
  /// modelling shortcut) - manually managed, never a live carrier API.
  shipment        Shipment?
  /// P9 phase 8: support requests a customer filed about this order.
  supportRequests SupportRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity        Int
  unitNetGrosze   Int
  unitGrossGrosze Int
  /// VAT is computed on the UNIT price then multiplied by quantity - not on
  /// the line total. The two differ by up to a grosz and invoices use the
  /// unit form.
  vatRateBp       Int    @default(2300)
  lineNetGrosze   Int
  lineVatGrosze   Int
  lineGrossGrosze Int

  /// FULL immutable snapshot (§6.8). Product name, design code, material,
  /// dimensions, finish, variant, personalization, module layout, the whole
  /// PriceBreakdown and the pricing version. Rendering an order NEVER joins
  /// to a live catalogue row - a test mutates every catalogue row after an
  /// order and asserts the rendered order is unchanged.
  snapshot        Json
  snapshotVersion Int  @default(1)
  /// Denormalised from the snapshot so the version can be queried and
  /// indexed without opening the JSON.
  pricingVersion  Int

  customerDesignId String?
  customerDesign   CustomerDesign?   @relation(fields: [customerDesignId], references: [id])
  /// Internal. Never shown to the customer in CAM terminology.
  productionMethod ProductionMethod?
  moduleCount      Int?

  @@index([orderId])
  @@index([customerDesignId])
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  ISSUE
  RETURNED
}

/// P9 phase 7: manually-managed shipment tracking - one order, one package
/// (real reality, not a modelling shortcut). No carrier API is integrated
/// anywhere in this project; every field here is set by a staff member
/// looking at a real package, not fetched live. `trackingNumber` may still
/// be given to the customer as a real reference to check on the carrier's
/// own site - this project just never claims to poll it (§9/§15's "no
/// fake carrier tracking" rule).
model Shipment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier        String?
  trackingNumber String?
  status         ShipmentStatus @default(PREPARING)

  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  /// Staff-only - a real problem (damaged in transit, lost, address issue).
  issueDescriptionPl String? @db.Text
  /// Staff-only - how it was actually resolved (reshipped, refunded, etc.).
  issueResolutionPl  String? @db.Text
  /// Staff-only, never shown to the customer.
  internalNotesPl    String? @db.Text
  /// Shown to the customer alongside the status - e.g. "paczka czeka w punkcie odbioru".
  customerNotesPl    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// P9 phase 8: support requests specifically about this shipment (e.g. "where is my package").
  supportRequests SupportRequest[]
}

enum SupportRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// P9 phase 8: a real, internal DB-driven support/contact workflow - no
/// fake external communication integration (no real email/chat/ticketing
/// system wired up here, §9/§15). A staff member reads and answers these
/// through the panel; `email` is how they'd actually reply, outside this
/// system, same honest limitation already documented for the mailer.
model SupportRequest {
  id String @id @default(cuid())

  /// Set when filed by a logged-in customer; null for a guest submission.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  /// Optional context - a request can stand alone, or be about one real order/shipment.
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id])
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  /// Always captured, even for a logged-in user - same "capture, don't
  /// re-read from the profile" discipline as `Order`'s own buyer fields.
  email     String
  namePl    String?
  subjectPl String
  messagePl String  @db.Text

  status       SupportRequestStatus @default(NEW)
  /// Staff-only - never shown to the customer.
  adminNotesPl String?              @db.Text

  /// 2026-08-30 duplicate sweep. The support form is zero-JS, so nothing on
  /// the client disables it while the action runs - a double-click or a
  /// browser retry filed the same question twice and staff could not tell
  /// whether the customer had really asked twice.
  ///
  /// A hash of (email, subject, message, order, five-minute bucket). The
  /// bucket is what makes this a duplicate GUARD rather than a permanent
  /// ban: writing in again next week with the same subject and message is a
  /// real second request - usually because nobody answered the first - and
  /// must never be silently swallowed. Nullable for rows written before
  /// this column existed; Postgres treats NULLs as distinct, so they never
  /// collide with each other.
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([orderId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  String // "system" | "staff" | "customer"
  actorId    String?
  actorEmail String? // denormalised: survives staff account deletion
  /// Mandatory on backwards transitions.
  notePl     String?      @db.Text
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Uploads, customer designs, review
// ---------------------------------------------------------------------------

enum UploadKind {
  CUSTOMER_DESIGN
  REFERENCE_PHOTO
}

enum DesignReviewStatus {
  PENDING_REVIEW
  APPROVED
  NEEDS_CHANGES
  REJECTED
}

model UploadedFile {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id])
  sessionToken   String?
  kind           UploadKind
  /// Opaque and unguessable. NEVER derived from the original filename, never
  /// exposed to the browser; files are streamed through an authorizing route.
  storageKey     String     @unique
  /// Sanitized, display only.
  originalName   String
  /// From magic-byte sniffing. The client's declared type is ignored for
  /// every security decision.
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  widthPx        Int?
  heightPx       Int?
  pageCount      Int? // PDF
  /// Preview is EXIF-stripped, including GPS.
  previewKey     String?
  createdAt      DateTime   @default(now())

  design CustomerDesign?

  @@index([userId])
  @@index([sessionToken])
}

model CustomerDesign {
  id               String             @id @default(cuid())
  fileId           String             @unique
  file             UploadedFile       @relation(fields: [fileId], references: [id])
  userId           String?
  user             User?              @relation(fields: [userId], references: [id])
  sessionToken     String?
  status           DesignReviewStatus @default(PENDING_REVIEW)
  /// P9 phase 2: the customer's own label for this upload ("Logo firmy",
  /// "Wzór na prezent") - lets them tell their own saved designs apart on
  /// the standalone library page. Optional: older rows and quick re-uploads
  /// have none, shown by original filename instead.
  titlePl          String?
  /// Decided internally during review. Not shown raw to the customer.
  productionMethod ProductionMethod?
  /// UploadWarning[] from the upload inspector (resolution, aspect, DPI).
  autoWarnings     Json?

  // IP consent record (brief §12). The exact text is stored, not just a
  // boolean - a consent record is only evidence if it captures what was
  // agreed to, and the wording will change over time.
  ipConfirmedAt        DateTime?
  ipDeclarationVersion String?
  ipDeclarationTextPl  String?   @db.Text
  ipConfirmedIp        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewComments DesignReviewComment[]
  orderItems     OrderItem[]
  configurations Configuration[]

  @@index([status])
  @@index([userId])
  @@index([sessionToken])
}

model DesignReviewComment {
  id         String         @id @default(cuid())
  designId   String
  design     CustomerDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  authorType String // "staff" | "customer"
  authorId   String?
  bodyPl     String         @db.Text
  createdAt  DateTime       @default(now())

  @@index([designId, createdAt])
}

// ---------------------------------------------------------------------------
// Users (Better Auth + Prisma adapter) and roles - P6, 2026-08-26
// ---------------------------------------------------------------------------
//
// `User`/`Account`/`Session`/`Verification` field names/shapes here are
// Better Auth's own exact expected schema - read directly from
// `node_modules/@better-auth/core/dist/db/schema/{user,account,session,
// verification}.d.mts` (its zod schemas), not guessed or copied from
// NextAuth/Auth.js's different convention (an earlier version of this
// schema was shaped for Auth.js specifically - see the P6 planning
// decision in `docs/HANDOVER.md` for why Better Auth replaced it: Auth.js
// v5 is still beta with no verified Prisma 7 support, Better Auth is
// stable and explicitly supports Prisma 7). `role`/`phone`/`anonymizedAt`
// on `User` are this project's own additions on top of Better Auth's base
// shape, registered via `user.additionalFields` in `src/server/auth/auth.ts`
// so the adapter round-trips them untouched.
//
// No real Account/Session/Verification rows existed before this migration
// (nothing used these tables - no auth existed yet), so this rebuilds
// them rather than attempting an in-place column rename with data to
// preserve.

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// There is no self-service path to STAFF or ADMIN. The first ADMIN is
  /// created by the seed script; further staff are invited from the panel.
  role          UserRole  @default(CUSTOMER)
  phone         String?
  /// RODO deletion anonymises the user and preserves order records, which
  /// Polish accounting law requires be retained.
  anonymizedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  configurations  Configuration[]
  carts           Cart[]
  orders          Order[]
  files           UploadedFile[]
  customDesigns   CustomerDesign[]
  /// P9 phase 8: support/contact requests this user has filed while logged in.
  supportRequests SupportRequest[]
  /// P9 continuation, 2026-08-28: catalogue designs this user has favourited.
  favoriteDesigns DesignFavorite[]
}

/// P9 continuation, 2026-08-28 - "wzory, które dodał do ulubionych" (owner
/// feedback): favouriting a real catalogue `Design`, distinct from
/// `CustomerDesign` (a customer's own uploaded file). Login-only by design -
/// unlike `CustomerDesign`/`Cart`, there is no guest `sessionToken` half:
/// a favourite is a durable preference tied to an account, not something a
/// guest checkout flow ever needs to carry across a session boundary.
model DesignFavorite {
  userId    String
  designId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, designId])
  @@index([designId])
}

/// One row per sign-in method a user has - the credentials ("local")
/// provider's hashed password lives here (`password`), never on `User`.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  /// "The stable provider-side key used to recognize an account"
  /// (Better Auth's own doc comment) - [issuer, accountId] together,
  /// not providerId, is the real natural key.
  issuer                String
  accountId             String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Audit and analytics
// ---------------------------------------------------------------------------

/// Every admin mutation writes one of these (§16A.2 invariant 4).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// Denormalised: survives staff account deletion.
  actorEmail String
  entity     String // "Product" | "PricingSettings" | "Order" | ...
  entityId   String?
  action     String // "create" | "update" | "delete" | "transition" | "publish"
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
}

/// First-party analytics. The configurator funnel cannot be built from GA4
/// without a reporting-API integration, and "where do people abandon the
/// configurator?" deserves data you own.
///
/// Written ONLY for sessions that granted consent. Rows older than 12 months
/// are pruned.
model AnalyticsEvent {
  id           String   @id @default(cuid())
  name         String // configurator_step_completed, add_to_cart, ...
  sessionToken String?
  userId       String?
  productId    String?
  step         String?
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionToken])
}

// ---------------------------------------------------------------------------
// Content - FAQ, static pages, customer reviews (P7b)
// ---------------------------------------------------------------------------

model Faq {
  id         String   @id @default(cuid())
  questionPl String
  answerPl   String   @db.Text
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Generic CMS-lite pages ("o nas", "dostawa i płatność", ...), rendered at
/// `/strony/[slug]` - deliberately NOT `/[slug]`, already claimed by
/// categories (`(shop)/[category]/page.tsx`). `Regulamin`/`Polityka
/// prywatności` stay their own hardcoded routes (real content since P6),
/// unrelated to this model.
model StaticPage {
  id         String   @id @default(cuid())
  slug       String   @unique
  titlePl    String
  bodyPl     String   @db.Text
  seoTitlePl String
  seoDescPl  String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One real customer testimonial per `Order` (`@unique` below), submitted by
/// the customer themselves once their order is `COMPLETED` - never authored
/// or edited by staff (§16A.1 module 9). Staff may only change `status`.
model Review {
  id               String       @id @default(cuid())
  orderId          String       @unique
  order            Order        @relation(fields: [orderId], references: [id])
  authorNamePl     String
  /// 1-5.
  rating           Int
  bodyPl           String       @db.Text
  status           ReviewStatus @default(PENDING)
  moderatedAt      DateTime?
  /// Denormalised: survives staff account deletion, same reasoning as
  /// `AuditLog.actorEmail`/`OrderEvent.actorEmail`.
  moderatedByEmail String?
  createdAt        DateTime     @default(now())

  @@index([status, createdAt])
}

/// True singleton (`id = 1`, same shape as `MachineSettings`): the real
/// bank-transfer account and the flat shipping rate, both previously
/// honest placeholders (`site.ts`'s "we'll send the account number
/// separately" text; `create-order.ts`'s `SHIPPING_FLAT_GROSZE` constant).
/// Bank fields stay nullable - NULL means "not configured yet," and every
/// caller keeps showing the same honest placeholder text until an admin
/// fills them in. `shippingFlatRateGrosze` is NOT nullable: checkout has
/// always charged a real number, so this column must always hold one too.
model StoreSettings {
  id                     Int      @id @default(1)
  bankAccountNumber      String?
  bankAccountHolderPl    String?
  shippingFlatRateGrosze Int
  /// The shop's own social profiles, shown in the strip above the navigation
  /// (owner request, 2026-09-04: that strip is for "fb insta itd", not for
  /// links to our own subpages).
  ///
  /// Settings rather than constants because a hard-coded profile URL would
  /// be a guess about an account that may not exist, and a social icon
  /// linking nowhere is worse than no icon. `null` means "not configured",
  /// and the strip renders nothing for it - the same nullable-means-unset
  /// contract the bank fields above already use.
  ///
  /// Validated as absolute https URLs on write (`applyUpdateStoreSettings`):
  /// these end up as an `href` on every page of the storefront, so anything
  /// looser is a stored-XSS vector in the most widely rendered place there
  /// is.
  facebookUrl            String?
  instagramUrl           String?
  tiktokUrl              String?
  youtubeUrl             String?
  updatedAt              DateTime @updatedAt
  updatedByEmail         String?
}

/// One rolling counter per rate-limited thing - `docs/ARCHITECTURE.md`
/// §16.1's "rate limits: uploads per session/hour, order creation per IP,
/// auth attempts", and the storage decision `docs/OPEN_ITEMS.md` §6 left
/// open (owner chose Postgres over Redis on 2026-08-30: no new
/// infrastructure, and the counter is already the shape
/// `OrderNumberCounter` uses).
///
/// `key` is the whole identity - `"login:email:ala@example.pl"`,
/// `"order:ip:1.2.3.4"` - so one table serves every limiter and adding one
/// needs no migration. It is the primary key precisely so the counter can
/// be a single atomic `INSERT … ON CONFLICT DO UPDATE … RETURNING`
/// statement: a read-then-write limiter loses updates under exactly the
/// concurrent load it exists to stop, which would make it report
/// protection it does not provide.
///
/// `windowStart` is the beginning of the current rolling window, not a
/// creation timestamp: the same statement resets both count and window
/// when the old window has elapsed, so an expired row is reused rather
/// than needing a sweeper. Rows for keys that go quiet are harmless - the
/// index on `windowStart` is there so a periodic prune can find them
/// cheaply if the table ever grows enough to care.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// DB-editable override for `mailer.ts`'s hardcoded subject/body text.
/// `key` matches `MailTemplate` there ('order-confirmation' |
/// 'verification-otp') - a fixed, closed set, so this is edit-only, never
/// create/delete from the panel. Absence of a row for a given key is not an
/// error: `mailer.ts` falls back to its own hardcoded default, which is
/// also where these rows' seeded values came from.
model EmailTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  subjectPl      String
  bodyPl         String   @db.Text
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}
